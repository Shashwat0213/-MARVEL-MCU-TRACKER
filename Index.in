<style id="manual-media-link-style">
.media-actions .download-btn,
.media-actions .trailer-btn { text-decoration:none; cursor:pointer; }
.media-actions button:disabled { opacity:.6; cursor:not-allowed; }
</style>

<!-- MCU Tracker Firebase V7 Cloud Sync -->
<!DOCTYPE html>
<html lang="en">
<head>
<meta name="theme-version" content="V10 • Admin Control Center">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Marvel Cinematic Universe Tracker — Firebase Edition</title>

<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>

/* =========================================================
   GLOBAL
========================================================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

:root{
    --bg:#05070d;
    --bg2:#09111f;

    --card:#0d1422;
    --card2:#111b2f;

    --primary:#00e5ff;
    --secondary:#0077ff;

    --accent:#ff3d00;
    --gold:#ffd54a;

    --text:#ffffff;
    --muted:#9db4d1;

    --border:#18345b;

    --success:#00e676;

    --shadow:0 0 25px rgba(0,229,255,.20);
    --strong-shadow:0 0 35px rgba(0,229,255,.35);
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:"Orbitron",sans-serif;

    background:
        radial-gradient(
            circle at 50% -10%,
            #15345f 0%,
            var(--bg) 55%
        );

    color:var(--text);

    min-height:100vh;

    overflow-x:hidden;

    position:relative;
}

/* Animated futuristic grid */

body::before{
    content:"";

    position:fixed;

    inset:0;

    background-image:
        linear-gradient(
            rgba(0,229,255,.035) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(0,229,255,.035) 1px,
            transparent 1px
        );

    background-size:40px 40px;

    animation:gridMove 20s linear infinite;

    pointer-events:none;

    z-index:-2;
}

body::after{
    content:"";

    position:fixed;

    inset:0;

    background:
        radial-gradient(
            circle at center,
            transparent 20%,
            rgba(0,0,0,.35) 100%
        );

    pointer-events:none;

    z-index:-1;
}

@keyframes gridMove{

    from{
        transform:translateY(0);
    }

    to{
        transform:translateY(40px);
    }
}


/* =========================================================
   CONTAINER
========================================================= */

.container{
    width:94%;

    max-width:1350px;

    margin:auto;

    padding:25px 0 40px;
}


/* =========================================================
   HEADER
========================================================= */

header{
    display:flex;

    justify-content:space-between;

    align-items:center;

    gap:20px;

    margin-bottom:25px;

    flex-wrap:wrap;
}

.logo{
    display:flex;

    flex-direction:column;

    font-size:2rem;

    font-weight:800;

    letter-spacing:1px;

    color:var(--primary);

    text-shadow:
        0 0 10px var(--primary),
        0 0 25px rgba(0,229,255,.5);

    animation:logoGlow 2s infinite alternate;
}

.powered{
    margin-top:8px;

    font-size:.68rem;

    font-weight:700;

    letter-spacing:4px;

    text-transform:uppercase;

    color:var(--primary);

    text-shadow:
        0 0 5px var(--primary),
        0 0 15px var(--primary),
        0 0 30px var(--secondary);

    animation:poweredGlow 2s ease-in-out infinite alternate;
}

@keyframes logoGlow{

    from{
        text-shadow:
            0 0 10px var(--primary);
    }

    to{
        text-shadow:
            0 0 15px var(--primary),
            0 0 35px var(--primary),
            0 0 60px rgba(0,229,255,.5);
    }
}

@keyframes poweredGlow{

    from{
        opacity:.75;
    }

    to{
        opacity:1;
    }
}


/* =========================================================
   TOP BUTTONS
========================================================= */

.topbar{
    display:flex;

    gap:10px;

    flex-wrap:wrap;
}

button{
    border:none;

    outline:none;

    border-radius:12px;

    font-family:"Orbitron",sans-serif;

    cursor:pointer;

    transition:.25s ease;
}

.top-btn{
    padding:12px 17px;

    background:
        linear-gradient(
            135deg,
            var(--primary),
            var(--secondary)
        );

    color:#fff;

    font-weight:700;

    box-shadow:var(--shadow);
}

.top-btn:hover{
    transform:translateY(-3px);

    box-shadow:
        0 0 20px rgba(0,229,255,.4),
        0 0 35px rgba(0,119,255,.25);
}


/* =========================================================
   MAIN PANEL
========================================================= */

.panel{
    background:
        linear-gradient(
            145deg,
            rgba(13,20,34,.94),
            rgba(8,16,29,.92)
        );

    backdrop-filter:blur(15px);

    border:1px solid var(--border);

    border-radius:22px;

    padding:22px;

    box-shadow:var(--strong-shadow);

    position:relative;

    overflow:hidden;
}

.panel::before{
    content:"";

    position:absolute;

    top:0;
    left:0;
    right:0;

    height:2px;

    background:
        linear-gradient(
            90deg,
            transparent,
            var(--primary),
            transparent
        );

    box-shadow:0 0 15px var(--primary);
}


/* =========================================================
   SEARCH
========================================================= */

.search-box{
    position:relative;

    margin-bottom:20px;
}

.search-box input{
    width:100%;

    padding:16px 20px 16px 50px;

    background:var(--card);

    color:var(--text);

    border:1px solid var(--border);

    border-radius:14px;

    outline:none;

    font-family:"Orbitron",sans-serif;

    font-size:.9rem;

    box-shadow:var(--shadow);

    transition:.3s;
}

.search-box input::placeholder{
    color:#6f87a5;
}

.search-box input:focus{
    border-color:var(--primary);

    box-shadow:
        0 0 15px rgba(0,229,255,.25),
        0 0 30px rgba(0,229,255,.1);
}

.search-icon{
    position:absolute;

    left:18px;

    top:50%;

    transform:translateY(-50%);

    font-size:20px;

    pointer-events:none;
}


/* =========================================================
   STATS DASHBOARD
========================================================= */

.stats{
    display:grid;

    grid-template-columns:
        repeat(4,1fr);

    gap:14px;

    margin-bottom:22px;
}

.stat-card{
    background:
        linear-gradient(
            145deg,
            rgba(17,27,47,.95),
            rgba(9,17,31,.95)
        );

    border:1px solid var(--border);

    border-radius:16px;

    padding:17px;

    text-align:center;

    transition:.3s;

    position:relative;

    overflow:hidden;
}

.stat-card::before{
    content:"";

    position:absolute;

    width:70px;

    height:70px;

    background:rgba(0,229,255,.08);

    border-radius:50%;

    top:-35px;

    right:-35px;
}

.stat-card:hover{
    transform:translateY(-4px);

    border-color:var(--primary);

    box-shadow:var(--shadow);
}

.stat-icon{
    font-size:22px;

    margin-bottom:7px;
}

.stat-number{
    display:block;

    font-size:1.45rem;

    font-weight:800;

    color:var(--primary);

    margin-bottom:5px;
}

.stat-label{
    font-size:.65rem;

    color:var(--muted);

    letter-spacing:1px;

    text-transform:uppercase;
}


/* =========================================================
   PROGRESS
========================================================= */

.progress-section{
    margin-bottom:22px;
}

.progress-header{
    display:flex;

    justify-content:space-between;

    align-items:center;

    margin-bottom:9px;

    gap:10px;
}

.progress-title{
    font-size:.8rem;

    color:var(--muted);

    letter-spacing:1px;
}

.progress-percent{
    color:var(--primary);

    font-weight:700;

    font-size:.8rem;
}

.progress{
    width:100%;

    height:15px;

    background:#17263e;

    border-radius:20px;

    overflow:hidden;

    border:1px solid #213a5e;
}

.progress-bar{
    width:0%;

    height:100%;

    background:
        linear-gradient(
            90deg,
            var(--primary),
            var(--secondary)
        );

    transition:.5s ease;

    box-shadow:
        0 0 15px var(--primary);

    display:flex;

    align-items:center;

    justify-content:center;
}


/* =========================================================
   FILTER BAR
========================================================= */

.filter-bar{
    display:flex;

    gap:10px;

    flex-wrap:wrap;

    margin-bottom:22px;
}

.filter-btn{
    padding:10px 14px;

    background:var(--card);

    color:var(--muted);

    border:1px solid var(--border);

    font-size:.7rem;

    font-weight:600;
}

.filter-btn:hover{
    color:#fff;

    border-color:var(--primary);
}

.filter-btn.active{
    background:
        linear-gradient(
            135deg,
            var(--primary),
            var(--secondary)
        );

    color:#fff;

    border-color:transparent;

    box-shadow:var(--shadow);
}


/* =========================================================
   SORT SELECT
========================================================= */

.sort-box{
    margin-left:auto;
}

.sort-box select{
    padding:10px 13px;

    border-radius:10px;

    border:1px solid var(--border);

    background:var(--card);

    color:var(--text);

    font-family:"Orbitron",sans-serif;

    font-size:.7rem;

    outline:none;

    cursor:pointer;
}


/* =========================================================
   MOVIE GRID
========================================================= */

.movie-list{
    list-style:none;

    display:grid;

    grid-template-columns:
        repeat(
            auto-fill,
            minmax(245px,1fr)
        );

    gap:18px;
}


/* =========================================================
   MOVIE CARD
========================================================= */

.movie-card{
    background:
        linear-gradient(
            145deg,
            rgba(13,20,34,.98),
            rgba(8,16,29,.98)
        );

    border:1px solid var(--border);

    border-radius:17px;

    overflow:hidden;

    position:relative;

    transition:.35s ease;

    box-shadow:
        0 8px 25px rgba(0,0,0,.25);
}

.movie-card:hover{
    transform:
        translateY(-8px)
        scale(1.015);

    border-color:var(--primary);

    box-shadow:
        0 0 25px rgba(0,229,255,.25),
        0 15px 35px rgba(0,0,0,.35);
}


/* =========================================================
   POSTER
========================================================= */

.poster-container{
    height:350px;

    position:relative;

    overflow:hidden;

    background:
        linear-gradient(
            135deg,
            #111b2f,
            #05070d
        );
}

.poster{
    width:100%;

    height:100%;

    object-fit:cover;

    display:block;

    transition:.5s ease;
}

.movie-type-badge{display:inline-flex;align-items:center;gap:5px;margin:3px 0 7px;padding:5px 8px;border:1px solid rgba(255,255,255,.14);border-radius:999px;font-size:.58rem;font-weight:800;letter-spacing:.04em;opacity:.9}.movie-type-badge:has(+ .movie-meta){}
.movie-card:hover .poster{
    transform:scale(1.06);
}

.poster-overlay{
    position:absolute;

    inset:0;

    background:
        linear-gradient(
            to top,
            rgba(5,7,13,.95),
            transparent 55%
        );

    pointer-events:none;
}


/* =========================================================
   PHASE BADGE
========================================================= */

.phase-badge{
    position:absolute;

    top:12px;

    left:12px;

    padding:7px 10px;

    border-radius:8px;

    background:rgba(0,0,0,.72);

    backdrop-filter:blur(8px);

    border:1px solid rgba(0,229,255,.35);

    color:var(--primary);

    font-size:.62rem;

    font-weight:700;

    letter-spacing:.5px;

    z-index:2;
}


/* =========================================================
   FAVORITE BUTTON
========================================================= */

.favorite-btn{
    position:absolute;

    top:10px;

    right:10px;

    width:38px;

    height:38px;

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:50%;

    background:rgba(0,0,0,.7);

    color:#fff;

    border:1px solid rgba(255,255,255,.15);

    font-size:18px;

    z-index:3;

    box-shadow:none;
}

.favorite-btn:hover{
    transform:scale(1.12);

    background:rgba(255,61,0,.8);
}

.favorite-btn.active{
    color:#ff3d00;

    text-shadow:
        0 0 10px #ff3d00;
}


/* =========================================================
   MOVIE INFORMATION
========================================================= */

.movie-info{
    padding:15px;
}

.movie-title{
    font-size:.9rem;

    line-height:1.45;

    min-height:42px;

    margin-bottom:12px;

    color:#fff;
}

.movie-meta{
    display:flex;

    flex-wrap:wrap;

    gap:7px;

    margin-bottom:13px;
}

.meta-item{
    padding:6px 8px;

    border-radius:7px;

    background:#101c30;

    border:1px solid #1c3557;

    color:var(--muted);

    font-size:.57rem;

    white-space:nowrap;
}

.rating{
    color:var(--gold);

    font-weight:700;
}


/* =========================================================
   WATCH BUTTON
========================================================= */

.watch-row{
    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:10px;
}

.watch-label{
    display:flex;

    align-items:center;

    gap:8px;

    color:var(--muted);

    font-size:.62rem;

    cursor:pointer;
}

.watch-checkbox{
    width:17px;

    height:17px;

    accent-color:var(--primary);

    cursor:pointer;
}

.watched-text{
    color:var(--success);

    font-weight:700;
}


/* =========================================================
   PHASE SECTION
========================================================= */

.phase-section{
    margin-top:25px;

    margin-bottom:10px;
}

.phase-title{
    font-size:.85rem;

    color:var(--primary);

    margin-bottom:12px;

    letter-spacing:1px;
}


/* =========================================================
   EMPTY STATE
========================================================= */

.empty-state{
    grid-column:1/-1;

    text-align:center;

    padding:50px 20px;

    color:var(--muted);

    border:1px dashed var(--border);

    border-radius:15px;

    background:rgba(13,20,34,.6);
}

.empty-icon{
    font-size:40px;

    margin-bottom:12px;
}


/* =========================================================
   RESET BUTTON
========================================================= */

.reset-btn{
    padding:11px 16px;

    background:
        linear-gradient(
            135deg,
            #ff3d00,
            #ff1744
        );

    color:#fff;

    font-weight:700;

    box-shadow:
        0 0 15px rgba(255,61,0,.2);
}

.reset-btn:hover{
    transform:translateY(-3px);

    box-shadow:
        0 0 25px rgba(255,61,0,.35);
}


/* =========================================================
   FOOTER
========================================================= */

footer{
    text-align:center;

    color:var(--muted);

    padding:25px 10px 5px;

    font-size:.65rem;

    letter-spacing:.5px;
}

.footer-highlight{
    color:var(--primary);

    font-weight:700;
}


/* =========================================================
   LIGHT THEME
========================================================= */

body.light-mode{
    --bg:#edf4ff;
    --bg2:#ffffff;

    --card:#ffffff;
    --card2:#f2f7ff;

    --text:#111827;
    --muted:#52627a;

    --border:#b9cee9;

    --shadow:0 0 20px rgba(0,100,200,.12);
    --strong-shadow:0 0 30px rgba(0,100,200,.16);
}

body.light-mode{
    background:
        radial-gradient(
            circle at top,
            #dceeff,
            #edf4ff 65%
        );
}

body.light-mode .movie-title{
    color:#111827;
}

body.light-mode .panel,
body.light-mode .movie-card,
body.light-mode .stat-card{
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.97),
            rgba(241,247,255,.97)
        );
}

body.light-mode .meta-item{
    background:#edf4ff;

    border-color:#c6d8ed;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:1000px){

    .stats{
        grid-template-columns:
            repeat(2,1fr);
    }

    .poster-container{
        height:320px;
    }
}


/* =========================================================
   MOBILE — 4 MOVIES PER ROW
========================================================= */

@media(max-width:700px){

    .movie-list{
        grid-template-columns:repeat(2,1fr);
        gap:10px;
    }

    .poster-container{
        height:280px;
    }

    .movie-info{
        padding:10px;
    }

    .movie-title{
        font-size:.72rem;
        min-height:35px;
    }

    .movie-meta{
        gap:4px;
    }

    .meta-item{
        font-size:.48rem;
        padding:5px 6px;
    }

    .watch-label{
        font-size:.5rem;
    }

    .watch-checkbox{
        width:14px;
        height:14px;
    }
}
/* =========================================================
   VERY SMALL PHONES — 2 MOVIES PER ROW
========================================================= */

@media(max-width:420px){

    .container{
        width:97%;
    }

    .panel{
        padding:10px;
    }

    .movie-list{
        grid-template-columns:repeat(2,minmax(0,1fr));
        gap:10px;
    }

    .poster-container{
        height:250px;
    }

    .movie-info{
        padding:8px;
    }

    .movie-title{
        font-size:.62rem;
        min-height:30px;
        margin-bottom:6px;
    }

    .movie-meta{
        gap:4px;
    }

    .meta-item{
        font-size:.4rem;
        padding:4px 5px;
    }

    .watch-label{
        font-size:.4rem;
    }

    .watch-checkbox{
        width:12px;
        height:12px;
    }

    .favorite-btn{
        width:28px;
        height:28px;
        font-size:13px;
    }

    .phase-badge{
        font-size:.35rem;
        padding:3px 5px;
    }

    .top-btn{
        padding:10px 12px;
        font-size:.65rem;
    }
}
 /* =========================================================
   CINEMATIC MOVIE DETAILS MODAL
   PART 1
========================================================= */

.movie-modal{
    position:fixed;
    inset:0;
    z-index:9999;

    display:flex;
    align-items:center;
    justify-content:center;

    padding:20px;

    background:rgba(0,0,0,.78);
    backdrop-filter:blur(14px);

    opacity:0;
    visibility:hidden;

    transition:
        opacity .35s ease,
        visibility .35s ease;
}

.movie-modal.active{
    opacity:1;
    visibility:visible;
}


/* MODAL BOX */

.movie-modal-content{
    width:min(1050px, 96vw);
    max-height:90vh;

    display:grid;
    grid-template-columns:320px 1fr;

    gap:28px;

    padding:25px;

    overflow:auto;

    background:
        linear-gradient(
            145deg,
            rgba(17,27,47,.98),
            rgba(5,10,20,.98)
        );

    border:1px solid rgba(0,229,255,.45);

    border-radius:24px;

    box-shadow:
        0 0 30px rgba(0,229,255,.25),
        0 0 80px rgba(0,119,255,.15);

    transform:
        translateY(40px)
        scale(.88);

    transition:
        transform .45s cubic-bezier(.16,1,.3,1);
}

.movie-modal.active .movie-modal-content{
    transform:
        translateY(0)
        scale(1);
}


/* BIG POSTER */

.movie-modal-poster{
    width:100%;
    height:460px;

    object-fit:cover;

    border-radius:16px;

    border:1px solid rgba(0,229,255,.3);

    box-shadow:
        0 0 25px rgba(0,229,255,.18);

    transition:
        transform .5s ease,
        box-shadow .5s ease;
}

.movie-modal-poster:hover{
    transform:scale(1.025);

    box-shadow:
        0 0 35px rgba(0,229,255,.35);
}


/* DETAILS */

.movie-modal-details{
    position:relative;

    display:flex;
    flex-direction:column;

    justify-content:center;
}


.movie-modal-title{
    margin-bottom:15px;

    font-size:1.8rem;
    line-height:1.3;

    color:#fff;

    text-shadow:
        0 0 10px rgba(0,229,255,.5);
}


.movie-modal-meta{
    display:flex;
    flex-wrap:wrap;

    gap:8px;

    margin-bottom:18px;
}


.movie-modal-meta span{
    padding:7px 10px;

    border-radius:8px;

    background:#101c30;

    border:1px solid #1c3557;

    color:var(--muted);

    font-size:.62rem;
}


.movie-modal-description{
    margin-bottom:22px;

    color:var(--muted);

    font-family:Arial,sans-serif;

    font-size:.95rem;

    line-height:1.7;
}


/* ACTION BUTTONS */

.movie-modal-actions{
    display:flex;

    flex-wrap:wrap;

    gap:10px;
}


.movie-modal-btn{
    padding:12px 17px;

    border:none;
    border-radius:10px;

    color:#fff;

    font-family:"Orbitron",sans-serif;

    font-size:.7rem;
    font-weight:700;

    cursor:pointer;

    transition:.25s ease;
}


.movie-modal-btn:hover{
    transform:translateY(-3px);

    box-shadow:
        0 0 20px rgba(0,229,255,.3);
}


.trailer-btn{
    background:
        linear-gradient(
            135deg,
            #ff1744,
            #ff3d00
        );
}


.watch-modal-btn{
    background:
        linear-gradient(
            135deg,
            var(--primary),
            var(--secondary)
        );
}


.favorite-modal-btn{
    background:#18263d;

    border:1px solid var(--border);
}


/* CLOSE BUTTON */

.movie-modal-close{
    position:absolute;

    top:12px;
    right:12px;

    width:40px;
    height:40px;

    display:flex;
    align-items:center;
    justify-content:center;

    border-radius:50%;

    background:rgba(0,0,0,.7);

    border:1px solid rgba(255,255,255,.15);

    color:#fff;

    font-size:20px;

    cursor:pointer;

    transition:.25s ease;

    z-index:5;
}


.movie-modal-close:hover{
    background:#ff1744;

    transform:
        rotate(90deg)
        scale(1.1);

    box-shadow:
        0 0 20px rgba(255,23,68,.4);
}


/* MODAL MOBILE */

@media(max-width:700px){

    .movie-modal{
        padding:10px;
    }

    .movie-modal-content{
        grid-template-columns:1fr;

        gap:15px;

        padding:15px;

        max-height:94vh;

        border-radius:18px;
    }

    .movie-modal-poster{
        height:380px;
    }

    .movie-modal-title{
        font-size:1.15rem;
    }

    .movie-modal-description{
        font-size:.8rem;
        line-height:1.6;
    }

    .movie-modal-btn{
        flex:1;

        min-width:120px;

        padding:10px 12px;

        font-size:.58rem;
    }
}


/* VERY SMALL PHONES */

@media(max-width:420px){

    .movie-modal-poster{
        height:300px;
    }

    .movie-modal-content{
        padding:10px;
    }

    .movie-modal-title{
        font-size:1rem;
    }

    .movie-modal-meta span{
        font-size:.5rem;
        padding:5px 7px;
    }
}


/* REDUCED MOTION */

@media(prefers-reduced-motion:reduce){

    .movie-modal,
    .movie-modal-content,
    .movie-modal-poster,
    .movie-modal-btn,
    .movie-modal-close{
        transition:none;
    }
}

/* PREMIUM V2 */
:root{--premium-accent:#e62429;--premium-accent2:#ffd54a;--premium-glow:rgba(230,36,41,.28)}
body{background:radial-gradient(circle at 20% 0%,var(--premium-glow),transparent 30%),radial-gradient(circle at 90% 10%,rgba(0,229,255,.10),transparent 28%),var(--bg,#05070b)!important}
.premium-hero{position:relative;overflow:hidden;margin:18px 0 22px;padding:34px 30px;border:1px solid rgba(255,255,255,.12);border-radius:26px;background:linear-gradient(120deg,rgba(10,12,18,.96),rgba(30,8,12,.82));box-shadow:0 20px 70px rgba(0,0,0,.35);isolation:isolate}
.premium-hero:before{content:"";position:absolute;inset:-45%;background:conic-gradient(from 120deg,transparent 0 35%,var(--premium-accent) 45%,transparent 55%,var(--premium-accent2) 70%,transparent 80%);filter:blur(70px);opacity:.16;z-index:-2;animation:heroSpin 18s linear infinite}
.premium-hero:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.68),transparent 75%);z-index:-1}
.hero-kicker{font-size:.75rem;letter-spacing:.22em;font-weight:800;color:var(--premium-accent2);text-transform:uppercase}.hero-title{font-size:clamp(2rem,5vw,4rem);line-height:.95;margin:10px 0;background:linear-gradient(90deg,#fff,var(--premium-accent2));-webkit-background-clip:text;background-clip:text;color:transparent}.hero-copy{max-width:650px;color:rgba(255,255,255,.72);line-height:1.6;margin:12px 0 20px}.hero-actions{display:flex;gap:10px;flex-wrap:wrap}.hero-btn{border:1px solid rgba(255,255,255,.14);border-radius:999px;padding:11px 16px;background:rgba(255,255,255,.07);color:#fff;cursor:pointer;font-weight:800}.hero-btn.primary{background:var(--premium-accent);border-color:transparent;box-shadow:0 8px 25px var(--premium-glow)}
.theme-switcher{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:0 0 18px;padding:10px 12px;border:1px solid rgba(255,255,255,.1);border-radius:16px;background:rgba(255,255,255,.035)}.theme-label{font-size:.72rem;font-weight:800;letter-spacing:.12em;opacity:.7;text-transform:uppercase}.theme-choice{border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.05);color:inherit;border-radius:999px;padding:7px 11px;cursor:pointer}.theme-choice.active{border-color:var(--premium-accent);box-shadow:0 0 0 2px var(--premium-glow)}

body.theme-blue{--premium-accent:#27a7ff;--premium-accent2:#a7e8ff;--premium-glow:rgba(39,167,255,.28)}body.theme-blue .premium-hero{background:linear-gradient(90deg,rgba(3,10,22,.97) 0%,rgba(5,18,38,.84) 42%,rgba(0,30,70,.25) 100%),url("https://image.tmdb.org/t/p/w780/1g0dhYtq4irTY1GPXvft6k4YLjm.jpg") center right/cover no-repeat;min-height:300px;display:flex;flex-direction:column;justify-content:center}.theme-blue .premium-hero:after{background:linear-gradient(90deg,rgba(0,5,15,.94),rgba(0,20,50,.5),transparent)}
body.theme-gold{--premium-accent:#d9a441;--premium-accent2:#fff0a8;--premium-glow:rgba(217,164,65,.28)}body.theme-gold .premium-hero{background:linear-gradient(90deg,rgba(12,9,2,.97) 0%,rgba(35,25,4,.82) 42%,rgba(60,45,10,.20) 100%),url("https://image.tmdb.org/t/p/w780/7WsyChQLEftFiDOVTGkv3hFpyyt.jpg") center right/cover no-repeat;min-height:300px;display:flex;flex-direction:column;justify-content:center}.theme-gold .premium-hero:after{background:linear-gradient(90deg,rgba(10,7,0,.95),rgba(30,20,3,.52),transparent)}
body.theme-cosmic{--premium-accent:#a855f7;--premium-accent2:#67e8f9;--premium-glow:rgba(168,85,247,.28)}body.theme-cosmic .premium-hero{background:linear-gradient(90deg,rgba(8,4,20,.97) 0%,rgba(24,8,42,.82) 42%,rgba(30,10,55,.22) 100%),url("https://image.tmdb.org/t/p/w780/r7vmZjiyZw9rpJMQJdXpjgiCOk9.jpg") center right/cover no-repeat;min-height:300px;display:flex;flex-direction:column;justify-content:center}.theme-cosmic .premium-hero:after{background:linear-gradient(90deg,rgba(8,2,20,.95),rgba(30,5,45,.5),transparent)}
body.theme-ironman{--premium-accent:#e10600;--premium-accent2:#ffcc66;--premium-glow:rgba(225,6,0,.32)}body.theme-ironman .premium-hero{background:linear-gradient(90deg,rgba(4,5,8,.96) 0%,rgba(8,9,13,.82) 42%,rgba(20,8,5,.30) 100%),url("https://image.tmdb.org/t/p/w780/78lPtwv72eTNqFW9COBYI0dWDJa.jpg") center right/cover no-repeat;min-height:300px;display:flex;flex-direction:column;justify-content:center;border-color:rgba(255,190,80,.22);box-shadow:0 25px 90px rgba(225,6,0,.18),inset 0 0 70px rgba(0,0,0,.35)}body.theme-ironman .premium-hero:before{background:radial-gradient(circle at 78% 45%,rgba(255,205,90,.72),transparent 7%),radial-gradient(circle at 78% 45%,rgba(0,190,255,.35),transparent 18%),conic-gradient(from 90deg,transparent 0 40%,#e10600 47%,transparent 55%,#ffcc66 68%,transparent 76%);filter:blur(35px);opacity:.32}body.theme-ironman .premium-hero:after{background:linear-gradient(90deg,rgba(0,0,0,.94) 0%,rgba(0,0,0,.72) 38%,rgba(0,0,0,.12) 100%)}body.theme-ironman .hero-kicker{color:#ffcc66;text-shadow:0 0 12px rgba(255,204,102,.55)}body.theme-ironman .hero-title{background:linear-gradient(90deg,#fff 0%,#ffcc66 55%,#e10600 100%);-webkit-background-clip:text;background-clip:text}body.theme-ironman .hero-btn.primary{background:linear-gradient(135deg,#e10600,#9b0000);box-shadow:0 8px 30px rgba(225,6,0,.38)}body.theme-ironman .theme-choice.active{border-color:#ffcc66;box-shadow:0 0 0 2px rgba(255,204,102,.16),0 0 20px rgba(225,6,0,.22)}
body:not(.theme-blue):not(.theme-gold):not(.theme-cosmic):not(.theme-ironman) .premium-hero{background:linear-gradient(90deg,rgba(12,3,5,.97) 0%,rgba(35,6,10,.82) 42%,rgba(70,8,14,.18) 100%),url("https://image.tmdb.org/t/p/w780/or06FN3Dka5tukK1e9sl16pB3iy.jpg") center right/cover no-repeat;min-height:300px;display:flex;flex-direction:column;justify-content:center}
.theme-poster-strip{display:flex;align-items:center;gap:14px;margin:-4px 0 20px;padding:10px 12px;border:1px solid rgba(255,255,255,.1);border-radius:18px;background:rgba(255,255,255,.035);overflow:hidden}.theme-poster-strip img{width:58px;height:82px;object-fit:cover;border-radius:10px;border:1px solid rgba(255,255,255,.14);box-shadow:0 8px 25px rgba(0,0,0,.3)}.theme-poster-info{min-width:0}.theme-poster-info strong{display:block;font-size:.78rem;letter-spacing:.05em}.theme-poster-info span{display:block;margin-top:4px;font-size:.58rem;opacity:.6}.theme-poster-chip{margin-left:auto;padding:7px 10px;border-radius:999px;font-size:.55rem;font-weight:800;border:1px solid var(--premium-accent);color:var(--premium-accent2);white-space:nowrap}@media(max-width:600px){.theme-poster-chip{display:none}.theme-poster-strip img{width:48px;height:68px}}
@keyframes heroSpin{to{transform:rotate(360deg)}}@media(max-width:600px){.premium-hero{padding:25px 20px}.continue-grid{grid-template-columns:1fr 1fr}}


/* =========================================================
   MCU TRACKER V3 — PREMIUM DASHBOARD
========================================================= */
.v3-dashboard{margin:0 0 24px;display:grid;grid-template-columns:1.35fr .65fr;gap:14px}
.v3-card{position:relative;overflow:hidden;border:1px solid rgba(255,255,255,.1);border-radius:20px;background:linear-gradient(145deg,rgba(17,27,47,.9),rgba(6,10,18,.92));box-shadow:0 14px 40px rgba(0,0,0,.2);padding:20px}
.v3-card:before{content:"";position:absolute;width:180px;height:180px;right:-80px;top:-90px;border-radius:50%;background:var(--premium-glow);filter:blur(12px);pointer-events:none}
.v3-profile{display:flex;align-items:center;justify-content:space-between;gap:15px}
.v3-greeting small{display:block;color:var(--muted);font-size:.65rem;letter-spacing:.14em;text-transform:uppercase;margin-bottom:6px}
.v3-greeting h2{font-size:1.35rem;margin:0 0 7px}.v3-greeting p{margin:0;color:rgba(255,255,255,.62);font:600 .78rem/1.5 Arial,sans-serif}
.v3-avatar{width:58px;height:58px;border-radius:18px;display:grid;place-items:center;background:linear-gradient(135deg,var(--premium-accent),var(--secondary));font-size:1.45rem;font-weight:900;box-shadow:0 0 25px var(--premium-glow)}
.v3-mini-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:17px}.v3-mini-stat{padding:10px;border-radius:13px;background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.07)}.v3-mini-stat strong{display:block;color:var(--premium-accent2);font-size:1rem}.v3-mini-stat span{font-size:.55rem;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}
.v3-progress{margin-top:15px}.v3-progress-row{display:flex;justify-content:space-between;font-size:.62rem;color:var(--muted);margin-bottom:7px}.v3-progress-track{height:9px;border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden}.v3-progress-fill{height:100%;width:0;background:linear-gradient(90deg,var(--premium-accent),var(--premium-accent2));box-shadow:0 0 15px var(--premium-glow);transition:width .5s ease}
.v3-next-title{font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;color:var(--premium-accent2);margin-bottom:8px}.v3-next-movie{display:flex;gap:12px;align-items:center;cursor:pointer}.v3-next-movie img{width:65px;height:92px;object-fit:cover;border-radius:10px;border:1px solid rgba(255,255,255,.12)}.v3-next-movie strong{display:block;font-size:.88rem;line-height:1.4}.v3-next-movie span{display:block;color:var(--muted);font-size:.58rem;margin-top:6px;line-height:1.5}
.v3-section{margin:0 0 24px}.v3-section-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.v3-section-head h2{font-size:.95rem;margin:0}.v3-section-head span{font-size:.58rem;color:var(--muted);letter-spacing:.1em;text-transform:uppercase}


.v3-profile-edit{display:flex;gap:7px;margin-top:12px}.v3-profile-edit input{flex:1;min-width:0;padding:9px 11px;border-radius:10px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.05);color:inherit;outline:none;font-family:inherit;font-size:.65rem}.v3-profile-edit button{padding:9px 12px;border-radius:10px;border:0;background:var(--premium-accent);color:#fff;font-weight:800;cursor:pointer}
body.light-mode .v3-card{background:rgba(255,255,255,.78);border-color:rgba(80,110,150,.15)}
body.light-mode .v3-greeting p{color:#52627a}
@media(max-width:900px){.v3-dashboard{grid-template-columns:1fr}}
@media(max-width:520px){.v3-mini-stats{grid-template-columns:repeat(3,1fr)}.v3-card{padding:15px}}


/* ===== PREMIUM LOCAL AUTH UI ===== */
.auth-bar{display:flex;align-items:center;gap:10px;margin-left:auto}
.auth-user{display:none;align-items:center;gap:9px;padding:6px 10px;border:1px solid rgba(255,255,255,.12);border-radius:999px;background:rgba(255,255,255,.045)}
.auth-avatar{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font-weight:900;background:linear-gradient(135deg,var(--premium-accent),var(--premium-accent2));color:#090b10}
.auth-user strong{font-size:.78rem;max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.auth-login-btn,.auth-logout-btn{border:1px solid rgba(255,255,255,.14);border-radius:12px;padding:9px 12px;background:rgba(255,255,255,.06);color:inherit;cursor:pointer;font-weight:800}
.auth-login-btn{background:linear-gradient(135deg,var(--premium-accent),var(--premium-accent2));color:#07080b;border:0}
.auth-overlay{position:fixed;inset:0;z-index:99999;display:none;align-items:center;justify-content:center;padding:20px;background:rgba(0,0,0,.72);backdrop-filter:blur(18px)}
.auth-overlay.open{display:flex}
.auth-card{width:min(430px,100%);border:1px solid rgba(255,255,255,.14);border-radius:28px;background:linear-gradient(145deg,rgba(20,24,34,.98),rgba(9,12,18,.98));box-shadow:0 30px 100px rgba(0,0,0,.55);padding:28px;position:relative}
.auth-close{position:absolute;right:15px;top:13px;width:36px;height:36px;border:0;border-radius:50%;background:rgba(255,255,255,.07);color:#fff;font-size:20px;cursor:pointer}
.auth-brand{font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--premium-accent2);font-weight:900}
.auth-card h2{font-size:2rem;margin:7px 0 5px}.auth-card p{opacity:.68;margin:0 0 20px;font-size:.9rem}
.auth-tabs{display:grid;grid-template-columns:1fr 1fr;gap:7px;padding:5px;background:rgba(255,255,255,.05);border-radius:13px;margin-bottom:18px}
.auth-tab{border:0;background:transparent;color:inherit;padding:10px;border-radius:9px;font-weight:800;cursor:pointer}.auth-tab.active{background:rgba(255,255,255,.11)}
.auth-form{display:grid;gap:12px}.auth-field{display:grid;gap:6px}.auth-field label{font-size:.74rem;font-weight:800;opacity:.72}.auth-field input{width:100%;box-sizing:border-box;border:1px solid rgba(255,255,255,.12);border-radius:12px;background:rgba(0,0,0,.22);color:inherit;padding:12px 13px;outline:none}.auth-field input:focus{border-color:var(--premium-accent);box-shadow:0 0 0 3px var(--premium-glow)}
.auth-submit{margin-top:4px;border:0;border-radius:13px;padding:13px;background:linear-gradient(135deg,var(--premium-accent),var(--premium-accent2));color:#07080b;font-weight:950;cursor:pointer}.auth-message{min-height:18px;font-size:.76rem;font-weight:700;color:#ff9b9b}.auth-note{font-size:.68rem;opacity:.5;margin-top:15px;line-height:1.5}
@media(max-width:760px){.auth-bar{width:100%;margin-top:10px}.auth-user{flex:1}.auth-user strong{max-width:180px}}


/* ===== V4 AUTH + ADMIN ===== */
.auth-bar{display:flex;justify-content:flex-end;align-items:center;gap:10px;margin:10px 0 16px}
.auth-user{display:none;align-items:center;gap:9px}.auth-avatar{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,var(--premium-accent,#e50914),#111);color:#fff;font-weight:800;box-shadow:0 0 18px var(--premium-glow,rgba(229,9,20,.3))}
.auth-login-btn,.auth-logout-btn,.auth-admin-btn{border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.06);color:inherit;border-radius:12px;padding:10px 14px;cursor:pointer;font-weight:700}.auth-admin-btn{background:linear-gradient(135deg,#d9a441,#8f5d00);color:#111}
.auth-overlay{position:fixed;inset:0;z-index:9999;display:none;align-items:center;justify-content:center;padding:18px;background:rgba(0,0,0,.78);backdrop-filter:blur(12px)}.auth-overlay.open{display:flex}.auth-card{width:min(460px,100%);padding:28px;border-radius:24px;background:linear-gradient(145deg,#161616,#090909);border:1px solid rgba(255,255,255,.14);box-shadow:0 25px 80px rgba(0,0,0,.55);position:relative}.auth-close{position:absolute;right:14px;top:10px;background:none;border:0;color:#aaa;font-size:28px;cursor:pointer}.auth-brand{font-size:12px;letter-spacing:2px;color:var(--premium-accent,#e50914);font-weight:800;margin-bottom:10px}.auth-card h2{font-size:30px;margin-bottom:5px}.auth-card p{color:#aaa;margin-bottom:18px}.auth-tabs{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:18px}.auth-tab{padding:11px;border-radius:10px;border:1px solid #333;background:#111;color:#aaa;cursor:pointer}.auth-tab.active{color:#fff;border-color:var(--premium-accent,#e50914);background:rgba(229,9,20,.12)}.auth-form{display:grid;gap:13px}.auth-field{display:grid;gap:6px}.auth-field label{font-size:12px;color:#aaa}.auth-field input{width:100%;padding:13px;border-radius:10px;border:1px solid #333;background:#080808;color:#fff;outline:none}.auth-field input:focus{border-color:var(--premium-accent,#e50914)}.auth-submit{padding:13px;border:0;border-radius:11px;background:linear-gradient(135deg,var(--premium-accent,#e50914),#7d0000);color:#fff;font-weight:800;cursor:pointer}.auth-message{min-height:18px;color:#ff7b7b;font-size:13px}.auth-note{margin-top:16px;color:#777;font-size:11px;line-height:1.5}
.admin-overlay{position:fixed;inset:0;z-index:9998;display:none;background:rgba(0,0,0,.82);backdrop-filter:blur(10px);padding:20px;overflow:auto}.admin-overlay.open{display:block}.admin-panel{width:min(1100px,100%);margin:30px auto;background:#0d0d0d;border:1px solid rgba(255,255,255,.12);border-radius:22px;padding:22px;box-shadow:0 30px 100px #000}.admin-head{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:18px}.admin-head h2{margin:0}.admin-close{border:0;background:#222;color:#fff;border-radius:10px;padding:9px 12px;cursor:pointer}.admin-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}.admin-stat{background:#151515;border:1px solid #262626;border-radius:14px;padding:16px}.admin-stat b{display:block;font-size:25px}.admin-stat span{color:#888;font-size:12px}.admin-table-wrap{overflow:auto;border:1px solid #252525;border-radius:14px}.admin-table{width:100%;border-collapse:collapse;min-width:700px}.admin-table th,.admin-table td{padding:12px;border-bottom:1px solid #222;text-align:left;font-size:13px}.admin-table th{color:#aaa;background:#141414}.admin-table td{color:#ddd}.admin-role{font-size:10px;padding:4px 7px;border-radius:999px;background:#222}.admin-role.admin{background:rgba(217,164,65,.18);color:#ffd979}.admin-actions{display:flex;gap:6px;flex-wrap:wrap}.admin-actions button{border:1px solid #333;background:#171717;color:#ddd;border-radius:8px;padding:7px 9px;cursor:pointer}.admin-actions button.danger{color:#ff8c8c}.admin-footer{color:#777;font-size:11px;margin-top:14px;line-height:1.5}@media(max-width:700px){.admin-stats{grid-template-columns:1fr 1fr}.auth-bar{justify-content:center}}

</style>

<style id="v8-autosync-ui">
  #firebaseSyncBtn,
  #firebaseBackupBtn,
  #firebaseRestoreBtn,
  #firebaseFileInput {
    display: none !important;
  }
  .v8-cloud-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: 8px;
    font-size: 12px;
    opacity: .9;
  }
</style>


<style id="v9-role-admin-css">
  #v9AdminPanel { display:none; margin:20px 0; padding:18px; border:1px solid rgba(255,255,255,.12); border-radius:14px; background:rgba(0,0,0,.18); }
  #v9AdminPanel input, #v9AdminPanel textarea { width:100%; box-sizing:border-box; padding:10px; border-radius:9px; margin:5px 0 10px; }
  #v9AdminPanel .v9-row { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  @media(max-width:700px){ #v9AdminPanel .v9-row{grid-template-columns:1fr;} }
  #v9AdminMessage { margin-top:10px; font-size:13px; }
</style>


<style id="v9-2-theme-order">
/*
  V9.2 THEME ORDER
  The original Red theme is moved to position #3.
  Massive Blue is NOT forced as the default theme.
*/
</style>


<style id="v12-responsive">
@media (max-width:600px){
  #v3Stats,.stats-grid,.tracker-stats{gap:6px!important}
  #v3Stats>*,.stats-grid>*,.tracker-stats>*{min-width:0!important;padding:8px 6px!important;border-radius:10px!important}
  #v3Stats strong,#v3Stats b,.stats-grid strong,.stats-grid b{font-size:16px!important}
  #v3Stats span,#v3Stats small,.stats-grid span,.stats-grid small{font-size:10px!important;white-space:nowrap}
}
.v12-avatar{width:72px;height:72px;border-radius:50%;object-fit:cover;border:2px solid rgba(255,255,255,.25)}
.v12-row{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
</style>


<style id="v13-working">
.v13-admin-tools{margin:12px 0;padding:14px;border:1px solid #444;border-radius:14px}
.v13-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:9px}
.v13-grid input,.v13-grid select,.v13-grid textarea{width:100%;box-sizing:border-box;padding:10px;border-radius:9px;border:1px solid #777;background:#181818;color:#fff}
.v13-actions{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}
.v13-result{padding:10px 0;border-bottom:1px solid #333;display:flex;justify-content:space-between;gap:8px;align-items:center}
@media(max-width:600px){.v13-grid{grid-template-columns:1fr}.v13-result{align-items:flex-start;flex-direction:column}}
</style>

<style id="mcu-v15">
.mcu-v15-admin{margin:14px 0;padding:16px;border:1px solid #444;border-radius:16px}
.mcu-v15-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:9px}
.mcu-v15-grid input,.mcu-v15-grid select,.mcu-v15-grid textarea{width:100%;box-sizing:border-box;padding:10px;border-radius:9px;border:1px solid #777;background:#181818;color:#fff}
.mcu-v15-actions{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}
.mcu-v15-row{padding:10px 0;border-bottom:1px solid #333;display:flex;justify-content:space-between;gap:10px;align-items:center}
@media(max-width:600px){.mcu-v15-grid{grid-template-columns:1fr}.mcu-v15-row{flex-direction:column;align-items:flex-start}}
</style>

<style id="mcu-v1-integrated-css">
/* V1 additive styling: keeps the original animation system intact. */
.mcu-v1-type{display:inline-block;margin-left:6px;padding:3px 7px;border-radius:999px;font-size:.52rem;font-weight:800;border:1px solid rgba(255,255,255,.14);opacity:.9}
.mcu-v1-importance{display:inline-block;margin-left:6px;padding:3px 7px;border-radius:999px;font-size:.52rem;font-weight:800;border:1px solid rgba(255,255,255,.14)}
body.theme-gamma{--premium-accent:#39d353;--premium-accent2:#b7ffbf;--premium-glow:rgba(57,211,83,.28)}
body.theme-gamma .premium-hero{background:linear-gradient(90deg,rgba(3,12,5,.97),rgba(7,28,12,.84),rgba(10,50,20,.22)),url("https://image.tmdb.org/t/p/w780/uxzzxijgPIY7slzFvMotPv8wjKA.jpg") center right/cover no-repeat;min-height:300px;display:flex;flex-direction:column;justify-content:center}
body.theme-gamma .premium-hero:after{background:linear-gradient(90deg,rgba(2,10,4,.95),rgba(3,30,10,.52),transparent)}
</style>

<style id="doomsday-timer-css">
/* Additive: timer only. Existing tracker cards/layout/animations are untouched. */
.doomsday-timer{
  margin:14px 0 18px;
  padding:14px 16px;
  border:1px solid rgba(80,255,140,.32);
  border-radius:16px;
  background:linear-gradient(180deg,rgba(7,28,17,.92),rgba(3,13,8,.94));
  box-shadow:0 0 24px rgba(40,255,110,.10),inset 0 0 28px rgba(30,255,100,.035);
  overflow:hidden;
}
.doomsday-timer__title{
  margin:0;
  color:#b9ffd0;
  font-family:"Orbitron",sans-serif;
  font-weight:900;
  letter-spacing:.08em;
  font-size:.78rem;
  text-transform:uppercase;
}
.doomsday-timer__copy{
  margin:6px 0 10px;
  color:rgba(220,255,230,.72);
  font-size:.6rem;
  line-height:1.55;
}
.doomsday-timer__digits{
  display:flex;
  flex-wrap:wrap;
  gap:7px;
}
.doomsday-timer__unit{
  min-width:66px;
  padding:7px 9px;
  text-align:center;
  border:1px solid rgba(90,255,150,.22);
  border-radius:9px;
  background:rgba(0,0,0,.24);
}
.doomsday-timer__unit b{
  display:block;
  color:#d4ffe0;
  font-family:"Orbitron",sans-serif;
  font-size:.9rem;
  line-height:1.1;
  text-shadow:0 0 9px rgba(70,255,120,.5);
}
.doomsday-timer__unit span{
  display:block;
  margin-top:3px;
  color:rgba(210,255,225,.55);
  font-size:.44rem;
  text-transform:uppercase;
}
.doomsday-timer.is-live .doomsday-timer__unit b{animation:ddPulse 1s ease-in-out infinite alternate}
@keyframes ddPulse{from{opacity:.78}to{opacity:1}}
@media(max-width:600px){.doomsday-timer{padding:12px}.doomsday-timer__unit{min-width:58px}}
</style>
</head>

<body>

<div class="container">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header>

        <h1 class="logo">

            ⚡ MARVEL MCU TRACKER

            <span class="powered">
                POWERED BY SHASHWAT
            </span>

        </h1>

        <div class="topbar">

            <button
                class="top-btn"
                id="themeBtn"
            >
                🌙 Dark
            </button>

            <button
                class="top-btn"
                id="soundBtn"
            >
                🔊 Sound
            </button>

            <button
                class="reset-btn"
                id="resetBtn"
            >
                🔄 Reset
            </button>

        </div>

    </header>


<!-- ===== AUTHENTICATION UI ===== -->
<div class="auth-bar" id="authBar">
  <div class="auth-user" id="authUserBox">
    <span class="auth-avatar" id="authAvatar">S</span>
    <strong id="authUserName">Guest</strong>
    <button class="auth-logout-btn" id="authLogoutBtn">Logout</button><button class="auth-admin-btn" id="authAdminBtn" style="display:none">🛡️ Admin</button>
  </div>
  <button class="auth-login-btn" id="authOpenBtn">👤 Login</button>
</div>

<div class="auth-overlay" id="authOverlay" aria-hidden="true">
  <section class="auth-card" role="dialog" aria-modal="true" aria-labelledby="authTitle">
    <button class="auth-close" id="authCloseBtn" aria-label="Close">×</button>
    <div class="auth-brand">⚡ MCU TRACKER ACCOUNT</div>
    <h2 id="authTitle">Welcome back</h2>
    <p id="authSubtitle">Sign in to keep your MCU journey tied to your account.</p>
    <div class="auth-tabs">
      <button class="auth-tab active" data-auth-tab="login">Login</button>
      <button class="auth-tab" data-auth-tab="signup">Create account</button>
    </div>
    <form class="auth-form" id="authForm">
      <div class="auth-field" id="authNameField" style="display:none">
        <label for="authName">Display name</label>
        <input id="authName" maxlength="24" autocomplete="name" placeholder="Your name">
      </div>
      <div class="auth-field">
        <label for="authEmail">Email</label>
        <input id="authEmail" type="email" autocomplete="email" required placeholder="you@example.com">
      </div>
      <div class="auth-field">
        <label for="authPassword">Password</label>
        <input id="authPassword" type="password" minlength="6" autocomplete="current-password" required placeholder="Minimum 6 characters">
      </div>
      <div class="auth-message" id="authMessage"></div>
      <button class="auth-submit" id="authSubmit" type="submit">Login</button>
<button type="button" id="v9GoogleBtn" class="auth-logout-btn" style="width:100%;margin-top:8px">Continue with Google</button>

    </form>
    <div class="auth-note">Your account is secured by Firebase Authentication. Your tracker progress and favorites can sync across devices when Firebase is configured.</div>
  </section>
</div>

<!-- ===== V4 ADMIN DASHBOARD ===== -->
<div class="admin-overlay" id="adminOverlay" aria-hidden="true">
<section class="admin-panel" role="dialog" aria-modal="true" aria-labelledby="adminTitle">
<div class="admin-head"><div><div class="auth-brand">MCU TRACKER V6</div><h2 id="adminTitle">🛡️ Admin Dashboard</h2></div><button class="admin-close" id="adminCloseBtn">✕ Close</button></div>
<div class="admin-stats"><div class="admin-stat"><b id="adminUsers">0</b><span>Total Users</span></div><div class="admin-stat"><b id="adminAdmins">0</b><span>Admins</span></div><div class="admin-stat"><b id="adminWatched">0</b><span>Watched Items</span></div><div class="admin-stat"><b id="adminFavorites">0</b><span>Favorites</span></div></div>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>User</th><th>Email</th><th>Role</th><th>Watched</th><th>Favorites</th><th>Actions</th></tr></thead><tbody id="adminUserRows"></tbody></table></div>
<div class="admin-footer">Local admin mode: accounts are stored in this browser. This is not production authentication. For real multi-device accounts, connect Supabase/Firebase.</div>
</section></div>

<section class="premium-hero" aria-label="Premium MCU dashboard">
  <div class="hero-kicker">Marvel Inspired • Personal Watch Tracker</div>
  <h2 class="hero-title">Your MCU. Your Timeline.</h2>
  <p class="hero-copy">Track every movie, discover what to watch next, manage favorites, and keep your progress in one cinematic dashboard.</p>
  <div class="hero-actions">
    <button class="hero-btn primary" id="heroExploreBtn">🎬 Explore Movies</button>
  </div>
</section>
<section class="theme-switcher" aria-label="Hero theme selector">
  <span class="theme-label">Hero Theme</span>
  <button class="theme-choice active" data-hero-theme="blue">🔵 Massive Blue</button>
  <button class="theme-choice" data-hero-theme="red">🔴 Marvel Red</button>
  <button class="theme-choice" data-hero-theme="gold">🟡 Infinity Gold</button>
  <button class="theme-choice" data-hero-theme="cosmic">🟣 Multiverse Purple</button>
  <button class="theme-choice" data-hero-theme="ironman">🤖 Stark Black</button>
  <button class="theme-choice" data-hero-theme="gamma">🟢 Gamma Green</button>
</section>
<section class="theme-poster-strip" aria-live="polite">
  <img id="themePoster" src="https://image.tmdb.org/t/p/w500/or06FN3Dka5tukK1e9sl16pB3iy.jpg" alt="Theme poster">
  <div class="theme-poster-info"><strong id="themePosterTitle">Avengers: Endgame</strong><span id="themePosterSubtitle">Marvel Red • Phase 3</span></div>
  <span class="theme-poster-chip">CINEMATIC THEME</span>
</section>




    <!-- =====================================================
         MAIN PANEL
    ====================================================== -->


<!-- V3 PREMIUM DASHBOARD -->
<section class="v3-dashboard" aria-label="Personal MCU dashboard">
  <div class="v3-card">
    <div class="v3-profile">
      <div class="v3-greeting">
        <small>Personal MCU Command Center</small>
        <h2 id="v3Greeting">Welcome back, Shashwat ⚡</h2>
        <p>Your cinematic journey and progress — all in one place.</p>
      </div>
      <div class="v3-avatar" id="v3Avatar">S</div>
    </div>
    <div class="v3-mini-stats">
      <div class="v3-mini-stat"><strong id="v3Watched">0</strong><span>Watched</span></div>
      <div class="v3-mini-stat"><strong id="v3Favs">0</strong><span>Favorites</span></div>
      <div class="v3-mini-stat"><strong id="v3Remaining">0</strong><span>Remaining</span></div>
    </div>
    <div class="v3-progress">
      <div class="v3-progress-row"><span>MCU Journey</span><b id="v3ProgressText">0%</b></div>
      <div class="v3-progress-track"><div class="v3-progress-fill" id="v3ProgressFill"></div></div>
    </div>
    <div class="v3-profile-edit">
      <input id="v3NameInput" maxlength="24" placeholder="Your display name">
      <button id="v3SaveName">Save</button>
    </div>
  </div>
  <div class="v3-card">
    <div class="v3-next-title">Recommended Next</div>
    <div class="v3-next-movie" id="v3NextMovie">
      <img id="v3NextPoster" src="" alt="Next movie poster">
      <div><strong id="v3NextTitle">Loading...</strong><span id="v3NextMeta">Your next unwatched movie</span></div>
    </div>
  </div>
</section>


<section id="v9AdminPanel" aria-hidden="true">
  <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
    <div><h3 style="margin:0">🛡️ 
<!-- ===== V10 ADMIN CONTROL CENTER ===== -->
<section id="v10AdminDashboard" class="admin-overlay" aria-hidden="true" style="display:none">
  <div class="admin-modal" style="max-width:1100px;width:96%;margin:3vh auto;padding:22px;border-radius:18px">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:12px">
      <div>
        <h2 style="margin:0">🛡️ MCU Tracker Admin Control Center</h2>
        <p style="margin:6px 0 0;opacity:.75">Manage users, movies and series from one place.</p>
      </div>
      <button type="button" id="v10AdminClose">✕</button>
    </div>

    <div style="display:flex;gap:8px;flex-wrap:wrap;margin:18px 0">
      <button type="button" data-v10-tab="overview">Overview</button>
      <button type="button" data-v10-tab="content">Movies & Series</button>
      <button type="button" data-v10-tab="users">Users</button>
    </div>

    <div id="v10OverviewTab">
      <div style=
